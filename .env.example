# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# Flask session signing key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Encryption key for parent email addresses stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose this key, stored email addresses cannot be decrypted. Back it up somewhere safe (NOT in git).
EMAIL_ENCRYPTION_KEY=

# Email settings. FROM_EMAIL is the address parents will receive check-out
# notifications from. Leave SMTP_HOST blank to run in "log only" mode - check-outs
# still work and messages are written to data/email_log.txt instead of being sent.
# For Gmail use smtp.gmail.com / 587 and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Kumon
# Instructor login. This is the single source of truth: on every start the app
# makes the database match these values - the password is updated if you change
# it here, and any other instructor account is removed.
INSTRUCTOR_USERNAME=instructor
INSTRUCTOR_PASSWORD=change-me-immediately

# Postgres connection string. In Supabase: Connect -> "Direct connection string"
# -> Transaction pooler. It must be the POOLER string (host contains
# "pooler.supabase.com", port 6543), not the direct one on 5432 - each copy of
# the app opens its own connection, and the direct connection runs out of them.
DATABASE_URL=

# Where the nightly PDF report is emailed. Leave blank and no report is sent -
# you can still download any date from the dashboard at any time.
REPORT_EMAIL=

# Shared secret for the nightly-close cron endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# On Vercel this is set automatically when you add a cron job; set it here too
# so you can trigger the job locally.
CRON_SECRET=

# Shown on the kiosk, in parent emails, and on the PDF report.
CENTER_NAME=Kumon

# Center's local timezone, e.g. America/Chicago
REPORT_TIMEZONE=America/Chicago

# The center runs 2 PM - 10 PM. At closing time every night, anyone still
# checked in is closed out automatically so they aren't blocked next session.
CENTER_CLOSE_HOUR=22
CENTER_CLOSE_MINUTE=0

# Days the center runs (comma separated). The nightly report is emailed on
# these days, and they're the dates offered on the dashboard.
REPORT_DAYS=mon,thu
